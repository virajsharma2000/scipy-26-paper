# ============================================================
# EXPERIMENT: Anomaly Blind-Spot Test
#
# Claim being tested: a monitor relying on SAE/NLA-style text
# feature labels can miss genuinely novel or anomalous internal
# states, because the SAE is forced to decompose ANY input into
# its existing (natural-language-trained) dictionary - even
# inputs that dictionary was never built to represent well.
#
# Design:
#   1. Build a "normal" prompt set (ordinary English text, the
#      kind GPT-2 and the SAE dictionary were built around) and
#      an "anomalous" prompt set (code, gibberish, repeated
#      tokens, non-English text - things GPT-2 still processes,
#      but that don't look like typical training data).
#   2. For every prompt, extract the last-token raw activation
#      and run it through the SAE (encode -> decode). Compare
#      how much of the activation survives reconstruction
#      (fraction of variance explained) between the two groups.
#   3. For a handful of anomalous prompts, look up what the
#      top-firing SAE feature is usually described as (via
#      Neuronpedia's public feature explanations for this exact
#      SAE). If those descriptions read as ordinary/mundane
#      despite a high reconstruction error, that's the blind
#      spot: a text-label monitor sees nothing alarming while
#      the raw signal is clearly abnormal.
#
# No classifiers, no train/test split, no labeling scheme that
# could hide a confound - just a direct measurement.
# ============================================================

!pip install transformer_lens sae_lens scipy requests -q

import torch
import torch.nn.functional as F
import numpy as np
import requests
from transformer_lens import HookedTransformer
from sae_lens import SAE
from scipy.stats import mannwhitneyu

device = "cuda" if torch.cuda.is_available() else "cpu"

# ── Load model and SAE ───────────────────────────────

model = HookedTransformer.from_pretrained("gpt2", device=device)
model.eval()
model.tokenizer.padding_side = "left"  # avoid the Condition 5 padding bug from the start

sae, cfg_dict, _ = SAE.from_pretrained(
    release="gpt2-small-res-jb",
    sae_id="blocks.8.hook_resid_pre",
)
sae = sae.to(device)

HOOK_NAME = "blocks.8.hook_resid_pre"

# ── Prompt sets ───────────────────────────────────────
# "Normal": ordinary English sentences, similar in spirit to
# the kind of text GPT-2 and this SAE were trained on.

normal_prompts = [
    "The weather today is sunny and warm.",
    "She walked to the store to buy some bread.",
    "The meeting has been rescheduled to next Tuesday.",
    "He enjoys reading books on weekends.",
    "The train arrived at the station on time.",
    "Our team won the game last night.",
    "The recipe calls for two cups of flour.",
    "They watched a movie together after dinner.",
    "The garden is full of blooming flowers this spring.",
    "I need to finish my homework before tomorrow.",
    "The library closes at eight in the evening.",
    "We are planning a trip to the mountains.",
    "The coffee shop on the corner makes great espresso.",
    "My favorite season is autumn because of the colors.",
    "The children played in the park all afternoon.",
    "He fixed the leaky faucet in the kitchen.",
    "The museum has a new exhibit on ancient history.",
    "She practices piano for an hour every day.",
    "The bakery sells fresh bread every morning.",
    "They adopted a puppy from the local shelter.",
]

# "Anomalous": things GPT-2 can still tokenize and process, but
# that don't resemble typical natural-language training data -
# code, repeated-token spam, gibberish, and non-English text.

anomalous_prompts = [
    "def foo(x, y): return x ** 2 + y ** 2 if x > 0 else None",
    "SELECT * FROM users WHERE id = 42 AND active = 1;",
    "the the the the the the the the the the the the",
    "asdkfj alskdjf laksjdf laksjdlf kajsdlfk ajsdlf",
    "xk9# @@!! ---> ;;;; ]]] {{{ ~~~~ ###",
    "0x1F 0x2A 0x3B 0x4C 0x5D 0x6E 0x7F 0x80 0x91",
    "печенье и молоко для завтрака каждый день",
    "import numpy as np; arr = np.zeros((3,3)); print(arr.T)",
    "111 222 333 444 555 666 777 888 999 000 111",
    "花火大会は毎年夏に開催されます、とても綺麗です",
    "<html><body><div class='x'>{{ broken }}</div></body>",
    "qwertyuiopasdfghjklzxcvbnmqwertyuiop",
    "function() { return null; } // TODO fix this later",
    "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "\\begin{equation} x^2 + y^2 = z^2 \\end{equation}",
    "01001000 01100101 01101100 01101100 01101111",
    "grbl grbl grbl frobnicate the wozzle blibber",
    "!!!???!!!???!!!???!!!???!!!???!!!???!!!???",
    "der die das ein eine einen dem den des ",
    "for(;;){if(x==null)break;else continue;}",
]

print(f"Normal prompts:    {len(normal_prompts)}")
print(f"Anomalous prompts: {len(anomalous_prompts)}")

# ── Extract last-token activations ───────────────────

def get_last_token_acts(prompts, model, batch_size=4):
    acts_list = []
    for i in range(0, len(prompts), batch_size):
        batch = prompts[i:i + batch_size]
        tokens = model.to_tokens(batch, prepend_bos=True)
        with torch.no_grad():
            _, cache = model.run_with_cache(tokens, names_filter=HOOK_NAME)
            acts_list.append(cache[HOOK_NAME][:, -1, :])
    return torch.cat(acts_list, dim=0)

print("Extracting activations for normal prompts...")
normal_acts = get_last_token_acts(normal_prompts, model)

print("Extracting activations for anomalous prompts...")
anomalous_acts = get_last_token_acts(anomalous_prompts, model)

# ── Reconstruction fidelity ──────────────────────────
# Fraction of variance explained (FVE): how much of the original
# activation survives being encoded and decoded by the SAE.
# Lower FVE = more information lost under SAE compression.

def fraction_variance_explained(acts, sae):
    with torch.no_grad():
        feats = sae.encode(acts)
        recon = sae.decode(feats)
        resid_sq = torch.sum((acts - recon) ** 2, dim=-1)
        total_sq = torch.sum(acts ** 2, dim=-1)
        fve = 1.0 - (resid_sq / total_sq)
    return fve.cpu().numpy(), feats.cpu().numpy()

fve_normal, feats_normal = fraction_variance_explained(normal_acts, sae)
fve_anomalous, feats_anomalous = fraction_variance_explained(anomalous_acts, sae)

print()
print("=== Reconstruction fidelity: normal vs. anomalous ===")
print(f"Normal    - mean FVE: {fve_normal.mean():.3f}  (std {fve_normal.std():.3f})")
print(f"Anomalous - mean FVE: {fve_anomalous.mean():.3f}  (std {fve_anomalous.std():.3f})")

u_stat, p_value = mannwhitneyu(fve_normal, fve_anomalous, alternative="greater")
print(f"Mann-Whitney U test (normal FVE > anomalous FVE): p = {p_value:.4f}")

if p_value < 0.05 and fve_normal.mean() > fve_anomalous.mean():
    print("=> The SAE reconstructs anomalous activations significantly worse")
    print("   than normal ones - real information is being lost specifically")
    print("   on inputs the dictionary wasn't built to represent.")
else:
    print("=> No significant reconstruction-fidelity gap detected between")
    print("   normal and anomalous prompts on this sample - the blind-spot")
    print("   claim is not supported by this data as designed.")

# ── What would a text-label monitor see? ─────────────
# For each anomalous prompt, find its top-firing SAE feature and
# try to pull its existing human-readable description from
# Neuronpedia. If a feature with a mundane-sounding description
# is the top match for a clearly anomalous input, that's the
# blind spot in action: the text label gives no indication
# anything unusual happened.
#
# NOTE: this hits a public API whose exact URL/response shape may
# have changed since this was written - if the request fails,
# check https://docs.neuronpedia.org or browse
# https://www.neuronpedia.org/gpt2-small/8-res-jb/<feature_index>
# manually for the printed feature indices instead.

def get_neuronpedia_explanation(feature_index, model_id="gpt2-small", layer_id="8-res-jb"):
    url = f"https://www.neuronpedia.org/api/feature/{model_id}/{layer_id}/{feature_index}"
    try:
        resp = requests.get(url, timeout=5)
        resp.raise_for_status()
        data = resp.json()
        explanations = data.get("explanations", [])
        if explanations:
            return explanations[0].get("description", "(no description text)")
        return "(no explanation on file for this feature)"
    except Exception as e:
        return f"(lookup failed: {e} - check feature manually at neuronpedia.org)"

print()
print("=== Top-firing feature per anomalous prompt, with its text label ===")
top_k = 1
for i, prompt in enumerate(anomalous_prompts):
    top_feature_idx = int(np.argmax(feats_anomalous[i]))
    top_feature_val = feats_anomalous[i][top_feature_idx]
    explanation = get_neuronpedia_explanation(top_feature_idx)
    print(f"\nPrompt:      {prompt[:60]!r}")
    print(f"FVE:         {fve_anomalous[i]:.3f}")
    print(f"Top feature: #{top_feature_idx} (activation {top_feature_val:.2f})")
    print(f"Label says:  {explanation}")

print()
print("Read through the labels above: if several read as ordinary,")
print("mundane concepts (not 'this looks like garbled/anomalous input')")
print("even where FVE is low, that's the concrete case for the paper -")
print("the text layer gave no warning where the raw signal clearly did.")
